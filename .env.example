# Solana JSON-RPC endpoint (devnet).
RPC_URL=https://api.devnet.solana.com
# CAIP-2 network id used in x402 requirements (Solana devnet).
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# x402 facilitator base URL used to verify and settle payments.
FACILITATOR_URL=https://x402.org/facilitator
# Mint of the payment token (any 6-decimal SPL mint). Default: devnet USDC.
# For the demo use the test mint from keys/test-mint.json, created by
# `npm run setup:wallets -- --fallback-mint`, e.g. USDC_MINT=FeyjUFJCsrdmRB7vJQqCtCXTxgKD11DfYqacVDDGRw2c
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Keypair files must be mode 0600 (`chmod 600 keys/*.json`); startup refuses otherwise.
# Keypair file of the gateway hold wallet that receives payments and pays out or refunds.
HOLD_KEYPAIR_PATH=keys/hold.json
# Keypair file of the demo agent wallet that pays for escalations.
AGENT_KEYPAIR_PATH=keys/agent.json
# Keypair file of the expert wallet (devnet demo only).
EXPERT_KEYPAIR_PATH=keys/expert.json
# Optional expert payout address; derived from EXPERT_KEYPAIR_PATH when empty.
EXPERT_WALLET=
# Price per escalation in USDC as a decimal string (converted to base units).
PRICE_USDC=0.50
# Platform fee in percent of the price, kept by the hold wallet on release.
FEE_PCT=10
# Seconds the expert has to answer before the payment is refunded.
SLA_SECONDS=60
# Shared secret the expert uses to access the inbox.
# At least 12 characters, generate with `openssl rand -hex 16`.
INBOX_TOKEN=change-me-inbox-token
# Secret used to sign job status links.
# At least 12 characters, generate with `openssl rand -hex 16`.
STATUS_SECRET=change-me-status-secret
# HTTP port of the gateway.
PORT=4021
# SQLite database file path. A database from an older schema is rejected: delete it or change the path.
DB_PATH=data/humanroute.db
# Gateway base URL the demo agent calls. Read only by the agent/demo, not by the gateway.
GATEWAY_URL=http://localhost:4021
# Solana commitment level for transaction confirmation: confirmed or finalized.
COMMITMENT=confirmed
