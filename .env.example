# Solana JSON-RPC endpoint (devnet).
RPC_URL=https://api.devnet.solana.com
# CAIP-2 network id used in x402 requirements (Solana devnet).
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# x402 facilitator base URL used to verify and settle payments.
FACILITATOR_URL=https://x402.org/facilitator
# Mint of the payment token (any 6-decimal SPL mint). Default: devnet USDC.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Keypair files must be mode 0600 (`chmod 600 keys/*.json`); startup refuses otherwise.
# Hold wallet: receives payments and sends the payouts and refunds.
HOLD_KEYPAIR_PATH=keys/hold.json
# Agent wallet: pays orders in scripts/e2e-flow.ts (devnet only).
AGENT_KEYPAIR_PATH=keys/agent.json
# HTTP port of the gateway.
PORT=4021
# SQLite database file. A v1 database is refused: use a fresh path (ADR 0022).
DB_PATH=data/humanroute.db
# Solana commitment level for transaction confirmation: confirmed or finalized.
COMMITMENT=confirmed
# Price of one task in USDC as a decimal string.
TASK_PRICE_USDC=0.50
# Timer preset: video (claim 60 s, work 180 s) or public (claim 1800 s, work 3600 s).
TIMER_MODE=video
# Optional overrides of the preset windows in seconds; empty uses the preset.
CLAIM_WINDOW_SECONDS=
WORK_WINDOW_SECONDS=
# Payout split in basis points; the three must sum to 10000.
LINGUIST_SHARE_BPS=8000
AGENCY_SHARE_BPS=1800
FEE_SHARE_BPS=200
# Required: Solana address that receives the fee share in each payout.
FEE_WALLET=
# Public URLs: the web app and the pay links, and the MCP endpoint shown to firms.
PUBLIC_BASE_URL=http://localhost:4021
MCP_PUBLIC_URL=http://localhost:4022/mcp
# Draft lifetime (seconds), session lifetime and sign-in nonce lifetime.
DRAFT_TTL_SECONDS=1800
SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=300
# Directory with the built web app (npm run build), served by the gateway.
WEB_DIST_DIR=web/dist
# MCP process (npm run mcp): the gateway it talks to and its port.
GATEWAY_URL=http://localhost:4021
MCP_PORT=4022
# Web Push (ADR 0029): all three or none; none turns push off. The subject must be a real mailto: or https: address (Apple answers 403 BadJwtToken to placeholders such as example.invalid). Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
