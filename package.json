{
	"name": "humanroute",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"start": "tsx --env-file=.env src/index.ts",
		"check": "biome check . && tsc --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p web/sw/tsconfig.json --noEmit && npm test",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p web/sw/tsconfig.json --noEmit",
		"test": "vitest run --project unit --project web",
		"test:e2e": "npm run build && vitest run --project e2e",
		"test:e2e:devnet": "npm run build && E2E_DEVNET=1 vitest run --project e2e-devnet",
		"test:smoke": "vitest run --project smoke",
		"setup:wallets": "tsx --env-file-if-exists=.env scripts/setup-wallets.ts",
		"e2e:devnet": "bash scripts/e2e-devnet.sh",
		"requeue": "tsx --env-file=.env src/requeue.ts",
		"web:dev": "vite --config web/vite.config.ts",
		"build": "vite build --config web/vite.config.ts",
		"mcp": "tsx mcp/index.ts"
	},
	"dependencies": {
		"@hono/node-server": "2.1.5",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@scure/base": "2.4.0",
		"@solana/kit": "8.5.0",
		"@solana/spl-token": "0.4.15",
		"@solana/web3.js": "1.99.0",
		"@x402/core": "2.28.0",
		"@x402/fetch": "2.28.0",
		"@x402/hono": "2.28.0",
		"@x402/svm": "2.28.0",
		"better-sqlite3": "13.0.3",
		"hono": "4.13.13",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"web-push": "3.6.7",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/web-push": "3.6.4",
		"@vitejs/plugin-react": "6.1.2",
		"jsdom": "31.0.0",
		"playwright": "1.65.0",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	}
}
