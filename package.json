{
  "name": "humanroute-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "setup:wallets": "tsx --env-file-if-exists=.env scripts/setup-wallets.ts",
    "setup-wallets": "tsx --env-file-if-exists=.env scripts/setup-wallets.ts",
    "demo": "tsx --env-file=.env agent/demo.ts",
    "demo:silent": "tsx --env-file=.env agent/demo.ts --silent"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@scure/base": "2.4.0",
    "@solana/kit": "8.5.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "@x402/svm": "2.28.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
