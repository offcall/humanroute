{
	"name": "humanroute",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"start": "tsx --env-file=.env src/index.ts",
		"check": "biome check . && tsc --noEmit",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"setup:wallets": "tsx --env-file-if-exists=.env scripts/setup-wallets.ts",
		"demo": "tsx --env-file=.env agent/demo.ts",
		"demo:silent": "tsx --env-file=.env agent/demo.ts --silent",
		"e2e:devnet": "bash scripts/e2e-devnet.sh",
		"requeue": "tsx --env-file=.env src/requeue.ts",
		"web:dev": "vite --config web/vite.config.ts",
		"web:build": "vite build --config web/vite.config.ts",
		"mcp": "tsx mcp/index.ts"
	},
	"dependencies": {
		"@hono/node-server": "2.1.5",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@scure/base": "2.4.0",
		"@solana/kit": "8.5.0",
		"@solana/spl-token": "0.4.15",
		"@solana/web3.js": "1.99.0",
		"@x402/core": "2.28.0",
		"@x402/fetch": "2.28.0",
		"@x402/hono": "2.28.0",
		"@x402/svm": "2.28.0",
		"better-sqlite3": "13.0.3",
		"hono": "4.13.13",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vite": "8.3.5"
	}
}
